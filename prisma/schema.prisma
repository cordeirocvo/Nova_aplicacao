generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  password          String
  role              String
  name              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  canAccessBudgets  Boolean  @default(false)
  canEditBudgets    Boolean  @default(false)
  canAccessAppLeads Boolean  @default(false)
  canManageCRM      Boolean  @default(false)
  canAccessSIE      Boolean  @default(false)
  allowedRoutes     String[] @default([])
  leads             Lead[]   @relation("VendedorLeads")
}

model PlanilhaInstalacao {
  id                    String   @id @default(cuid())
  idInterno             String?  @unique
  instalacao            String?
  diaPrev               String?
  manualInstalacao      Boolean  @default(false)
  obsInstalacao         String?
  vencimentoParecer     String?
  vencimentoContrato    String?
  automaticoPrevInstala String?
  dataVenda             String?
  statusProtocolo       String?
  statusCompra          String?
  inversor              String?
  numMod                String?
  modulo                String?
  cidadeSheet           String?
  bairro                String?
  rua                   String?
  numRua                String?
  telhado               String?
  telefoneSheet         String?
  vendedorSheet         String?
  observacao            String?
  anexoFotos            String[]
  anexoArquivos         String[]
  dataSolicitacao       DateTime @default(now())
  solicitacao           String?
  status                String?  @default("Pendente")
  vendedor              String?
  telefoneCliente       String?
  cidade                String?
  dataPrevista          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  atividadeExtra        Boolean  @default(false)
  prioridade            Boolean  @default(false)
  notificadoWhatsapp    Boolean  @default(false)
  telefoneVendedor      String?
  historico             Json?    @default("[]")

  @@index([idInterno])
  @@index([status])
  @@index([createdAt])
  @@index([updatedAt])
}

model Tarifas {
  id             String   @id @default(cuid())
  distribuidora  String
  subGrupo       String
  modalidade     String
  postoTarifario String
  valorTUSD      Float
  valorTE        Float
  dataInicio     DateTime
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([distribuidora, subGrupo, modalidade, postoTarifario])
}

model StatusOption {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSettings {
  id            String   @id @default("default")
  limiteVerde   Int      @default(40)
  limiteAmarelo Int      @default(20)
  limiteParecer Int      @default(30)
  updatedAt     DateTime @updatedAt
}

model ManufacturerAPI {
  id        String   @id @default(cuid())
  name      String   @unique
  userKey   String?
  secretKey String?
  apiUrl    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Carregador {
  id            String      @id @default(cuid())
  brand         String
  model         String
  power         Float
  voltage       Int
  phases        Int
  current       Float
  connectorType String?
  protectionReq String?
  groundingReq  String?
  datasheetUrl  String?
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  projects      EVProject[]
}

model EVProject {
  id                          String     @id @default(cuid())
  projectName                 String
  clientName                  String?
  clientDocument              String?
  clientPhone                 String?
  clientEmail                 String?
  clientAddress               String?
  projectDescription          String?
  utility                     String     @default("CEMIG")
  entranceCategory            String?
  distance                    Float
  installationMethod          String
  chargerId                   String
  calculatedCurrent           Float
  calculatedCableGauge        Float
  calculatedBreaker           Float
  calculatedDR                String?
  calculatedConduit           String?
  voltageDrop                 Float
  groundingAnalysis           String?
  isServiceEntranceOk         Boolean    @default(true)
  analysisNotes               String?
  hasTransformer              Boolean    @default(false)
  transformerPrimaryVoltage   Float?     @default(220)
  transformerSecondaryVoltage Float?     @default(380)
  transformerDistance         Float?     @default(10)
  chargerDistance             Float?     @default(10)
  groundingType               String?    @default("TT")
  calculatedPrimaryCable      Float?
  calculatedPrimaryBreaker    Float?
  calculatedDPS               String?
  calculatedIDR               String?
  fireExtinguisherType        String?
  hasEmergencyButton5m        Boolean    @default(true)
  requiresWarningSigns        Boolean    @default(true)
  fireDeptStandards           String?
  abntStandards               String?
  specificSafetyNotes         String?
  existingLoadKW              Float?     @default(0)
  simultaneityFactor          Float?     @default(0.8)
  isCollective                Boolean    @default(false)
  location                    String?    @default("urbano")
  cosPhi                      Float?     @default(1.0)
  existingEntrancePhases      Int?       @default(3)
  existingEntranceBreaker     Float?     @default(50)
  existingEntranceCable       Float?     @default(10)
  existingEntranceCategory    String?
  demandControlEnabled        Boolean?   @default(false)
  demandControlLimit          Float?     @default(50)
  createdAt                   DateTime   @default(now())
  updatedAt                   DateTime   @updatedAt
  charger                     Carregador @relation(fields: [chargerId], references: [id])
}

model EngeProjeto {
  id                 String              @id @default(cuid())
  nome               String
  cliente            String?
  tipo               String
  status             String              @default("Rascunho")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  levantamentoCargas Json?
  analiseFatura      AnaliseFatura?
  analiseMassa       AnaliseMassaDados[]
  estudoBESS         EstudoBESS?
  estudoSolar        EstudoSolar?
  usinaFotovoltaica  UsinaFotovoltaica?
}

model AnaliseFatura {
  id                    String      @id @default(cuid())
  projetoId             String      @unique
  nomeCliente           String?
  endereco              String?
  concessionaria        String?
  numeroInstalacao      String?
  cnpjCpfTitular        String?
  grupoTarifario        String?
  subgrupo              String?
  modalidadeTarifaria   String?
  classeConsumo         String?
  consumoMeses          Json?
  consumoMedioMensalKWh Float?
  consumoTotalAnualKWh  Float?
  demandaContratadaKW   Float?
  demandaMedidaHPKW     Float?
  demandaMedidaHFPKW    Float?
  temGeracao            Boolean     @default(false)
  geracaoTipos          String?
  geracaoInjetadaKWh    Float?
  tusd                  Float?
  te                    Float?
  tarifaHP              Float?
  tarifaHFP             Float?
  tarifaDemandaHP       Float?
  tarifaDemandaHFP      Float?
  valorUltimaFatura     Float?
  bandeiraTarifaria     String?
  rawPdfUrl             String?
  extraidoPorIA         Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  padraoConexao         String?
  descontoIrrigante     Float?
  energiaAtivaHRKWh     Float?
  mesReferencia         String?
  vencimento            String?
  projeto               EngeProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model AnaliseMassaDados {
  id                  String      @id @default(cuid())
  projetoId           String
  rawXlsUrls          String[]
  nomeArquivos        String[]
  postoHP_inicio      String?     @default("18:00")
  postoHP_fim         String?     @default("21:00")
  postoHFP_inicio     String?     @default("21:00")
  postoHFP_fim        String?     @default("18:00")
  postoHR_inicio      String?
  postoHR_fim         String?
  diasUteisSemana     Int[]       @default([1, 2, 3, 4, 5])
  periodoInicio       DateTime?
  periodoFim          DateTime?
  totalRegistros      Int?
  maxDemandaHP        Float?
  maxDemandaHFP       Float?
  maxDemandaHR        Float?
  maxDemandaTotal     Float?
  consumoHP_kWh       Float?
  consumoHFP_kWh      Float?
  consumoHR_kWh       Float?
  curvaMediaDiaria    Json?
  curvaHP             Json?
  curvaHFP            Json?
  diaCriticoData      DateTime?
  diaCriticoDemandaKW Float?
  diaCriticoCurva     Json?
  mediaDiaCritico     Float?
  maxDemandaTotalData DateTime?
  minDemandaTotal     Float?
  minDemandaTotalData DateTime?
  processado          Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  projeto             EngeProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model InversorSolar {
  id                 String   @id @default(cuid())
  fabricante         String
  modelo             String
  potenciaNominalKW  Float
  tipoConexao        String
  tensaoEntradaMinV  Float?
  tensaoEntradaMaxV  Float?
  correnteMaxCC      Float?
  numeroStringsMPPT  Int?
  potenciaMPPTKW     Float?
  tensaoSaidaVAC     Float?
  fatorPotencia      Float?
  eficiencia         Float?
  comunicacao        String?
  ipBD               String?
  datasheetUrl       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  fase               Int?     @default(1)
  ieee1547Compliant  Boolean? @default(false)
  powerFactorControl Boolean? @default(false)
  responseTimeMs     Float?
  thdMax             Float?
}

model ModuloFotovoltaico {
  id             String   @id @default(cuid())
  fabricante     String
  modelo         String
  potenciaPicoWp Float
  Vmp            Float?
  Imp            Float?
  Voc            Float?
  Isc            Float?
  eficiencia     Float?
  dimensoes      String?
  pesoKg         Float?
  coefTempVoc    Float?
  coefTempIsc    Float?
  garantiaAnos   Int?
  datasheetUrl   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BateriaSistema {
  id                   String   @id @default(cuid())
  fabricante           String
  modelo               String
  tecnologia           String
  capacidadeNomKWh     Float
  tensaoNominalV       Float?
  profundidadeDescarga Float?
  ciclosVida           Int?
  correnteMaxCarga     Float?
  correnteMaxDescarga  Float?
  tempOperacaoMin      Float?
  tempOperacaoMax      Float?
  datasheetUrl         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  roundTripEfficiency  Float?
  standbyLossesKW      Float?
  thermalBufferLower   Float?   @default(0.1)
  thermalBufferUpper   Float?   @default(0.9)
}

model EstruturaFotovoltaica {
  id                String   @id @default(cuid())
  fabricante        String
  modelo            String
  tipoTelhado       String
  materialEstrutura String?
  cargaMaxVentoKNm2 Float?
  modulosMaxFileira Int?
  anguloMin         Float?
  anguloMax         Float?
  datasheetUrl      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EstudoBESS {
  id                 String      @id @default(cuid())
  projetoId          String      @unique
  demandaAlvoKW      Float?
  estrategia         String?
  bateriaId          String?
  inversorId         String?
  quantidadeBaterias Int         @default(1)
  picoReduzidoKW     Float?
  economiaMensalLeve Float?
  economiaMensalBESS Float?
  paybackSimples     Float?
  vpl                Float?
  tir                Float?
  configSimulacao    Json?
  resultadosGrafico  Json?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  projeto            EngeProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model EstudoSolar {
  id                    String      @id @default(cuid())
  projetoId             String      @unique
  lat                   Float?
  long                  Float?
  hspManual             Float?
  hspPvgis              Float?
  tilt                  Float       @default(0)
  azimuth               Float       @default(0)
  pr                    Float       @default(0.75)
  perdaSistema          Float       @default(0.14)
  geracaoAlvoKWh        Float?
  potenciaNecessariaKWp Float?
  moduloId              String?
  inversorId            String?
  quantidadeModulos     Int         @default(0)
  quantidadeInversores  Int         @default(1)
  numStrings            Int         @default(1)
  modulosPorString      Int         @default(1)
  areaOcupadaM2         Float?
  pesoTotalKg           Float?
  investimentoEstimado  Float?
  paybackAnos           Float?
  vpl                   Float?
  tir                   Float?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  inversoresSugeridos   Json?
  overEnclosureAlvo     Float?      @default(1.40)
  projeto               EngeProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model UsinaFotovoltaica {
  id               String                 @id @default(cuid())
  projetoId        String?                @unique
  nome             String
  localizacao      String?
  comissionamentos ComissionamentoUsina[]
  equipamentos     EquipamentoUsina[]
  manutencoes      ManutencaoUsina[]
  termografias     RelatorioTermografia[]
  projeto          EngeProjeto?           @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model EquipamentoUsina {
  id                String            @id @default(cuid())
  usinaId           String
  nome              String
  tag               String
  localizacao       String?
  criticidade       String?
  periodicidadeDias Int?
  fotoBase64        String?
  anexos            Json?
  usina             UsinaFotovoltaica @relation(fields: [usinaId], references: [id], onDelete: Cascade)
  manutencoes       ManutencaoUsina[]
}

model ManutencaoUsina {
  id             String            @id @default(cuid())
  usinaId        String
  equipamentoId  String?
  tipo           String
  dataAgendada   DateTime
  dataRealizada  DateTime?
  status         String            @default("Pendente")
  descricao      String?
  fotosUrls      String[]
  documentosUrls String[]
  responsavel    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  custoMateriais Float?
  fotosDetalhes  Json?
  pecasTrocadas  String?
  tempoFim       DateTime?
  tempoInicio    DateTime?
  custoMaoDeObra Float?
  equipamento    EquipamentoUsina? @relation(fields: [equipamentoId], references: [id])
  usina          UsinaFotovoltaica @relation(fields: [usinaId], references: [id], onDelete: Cascade)

  @@index([usinaId])
  @@index([status])
  @@index([dataAgendada])
}

model ComissionamentoUsina {
  id             String            @id @default(cuid())
  usinaId        String
  tipo           String
  data           DateTime
  responsavel    String?
  numero         String?
  status         String            @default("Concluído")
  dadosTecnicos  Json?
  observacoes    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  crea           String?
  profissionalId String?
  profissional   Profissional?     @relation(fields: [profissionalId], references: [id])
  usina          UsinaFotovoltaica @relation(fields: [usinaId], references: [id], onDelete: Cascade)
}

model Profissional {
  id               String                 @id @default(cuid())
  nome             String
  telefone         String?
  email            String?
  crea             String?
  observacao       String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  comissionamentos ComissionamentoUsina[]
  termografias     RelatorioTermografia[]
}

model RelatorioTermografia {
  id                  String            @id @default(cuid())
  usinaId             String
  profissionalId      String?
  dataInspecao        DateTime          @default(now())
  equipamentoCamera   String?
  temperaturaAmbiente Float?
  irradiacao          Float?
  velocidadeVento     Float?
  umidadeRelativa     Float?
  emissividade        Float?            @default(0.95)
  distanciaRef        Float?            @default(1.0)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  itens               ItemTermografia[]
  profissional        Profissional?     @relation(fields: [profissionalId], references: [id])
  usina               UsinaFotovoltaica @relation(fields: [usinaId], references: [id], onDelete: Cascade)
}

model ItemTermografia {
  id                    String               @id @default(cuid())
  relatorioId           String
  tipoEquipamento       String
  tag                   String
  localizacao           String?
  temperaturaMedida     Float
  temperaturaReferencia Float
  deltaT                Float
  severidade            String
  causaProvavel         String?
  recomendacao          String?
  imagemTermicaUrl      String?
  imagemVisualUrl       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  relatorio             RelatorioTermografia @relation(fields: [relatorioId], references: [id], onDelete: Cascade)
}

model Lead {
  id          String      @id @default(cuid())
  nome        String
  telefone    String
  email       String?
  empresa     String?
  tipo        String
  status      String      @default("NOVO")
  latitude    Float?
  longitude   Float?
  observacoes String?
  vendedorId  String
  atendido    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  endereco    String?
  vendedor    User        @relation("VendedorLeads", fields: [vendedorId], references: [id])
  midias      LeadMidia[]
}

model LeadMidia {
  id         String   @id @default(cuid())
  leadId     String
  tipo       String
  arquivoUrl String
  createdAt  DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model OrcamentoProjeto {
  id              String                @id @default(cuid())
  nome            String
  cliente         String?
  status          String                @default("Rascunho")
  idContaAzul     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  dataAtualizacao DateTime              @default(now())
  fornecedores    FornecedorOrcamento[]
  etapas          OrcamentoEtapa[]
}

model OrcamentoEtapa {
  id        String           @id @default(cuid())
  projetoId String
  nome      String
  ordem     Int              @default(0)
  projeto   OrcamentoProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  itens     OrcamentoItem[]
}

model OrcamentoItem {
  id                String         @id @default(cuid())
  etapaId           String
  codigo            String?
  descricao         String
  tipo              String
  unidade           String
  quantidade        Float
  precoBaseUnitario Float?
  bdiPercent        Float          @default(0)
  imagemUrl         String?
  etapa             OrcamentoEtapa @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  propostas         PropostaItem[]
}

model OrcamentoItemPadrao {
  id                String   @id @default(cuid())
  codigo            String?
  descricao         String
  tipo              String
  unidade           String
  precoBaseUnitario Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model OrcamentoTipoMaterial {
  id         String   @id @default(cuid())
  nome       String   @unique
  bdiDefault Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Fornecedor {
  id              String                @id @default(cuid())
  razaoSocial     String
  contatoNome     String?
  contatoEmail    String?
  contatoTelefone String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  projetos        FornecedorOrcamento[]
  propostas       PropostaItem[]
}

model FornecedorOrcamento {
  id            String           @id @default(cuid())
  projetoId     String
  fornecedorId  String
  tokenAcesso   String           @unique @default(cuid())
  status        String           @default("Pendente")
  createdAt     DateTime         @default(now())
  statusConvite String?          @default("Pendente")
  fornecedor    Fornecedor       @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  projeto       OrcamentoProjeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)
}

model PropostaItem {
  id            String        @id @default(cuid())
  itemId        String
  fornecedorId  String
  precoUnitario Float
  observacao    String?
  createdAt     DateTime      @default(now())
  dataProposta  DateTime?     @default(now())
  versao        Int           @default(1)
  fornecedor    Fornecedor    @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  item          OrcamentoItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, fornecedorId, versao])
}

model Usina {
  id              String                @id @default(cuid())
  nome            String
  capacidadeKWp   Float
  localizacao     String?
  orientacao      String?
  inclinacao      Float?
  apiFornecedor   String
  apiId           String
  createdAt       DateTime              @default(now())
  coefSujidade    Float                 @default(0.03)
  coefTemperatura Float                 @default(-0.0035)
  taxaDegradacao  Float                 @default(0.005)
  estacaoId       String?
  apiKey          String?
  apiSecret       String?
  latitude        Float?
  longitude       Float?
  modoIrradiancia String                @default("ESTACAO")
  alarmes         Alarme[]
  analises        AnalisePerda[]
  inversores      Inversor[]
  telemetria      Telemetria[]
  estacao         EstacaoSolarimetrica? @relation(fields: [estacaoId], references: [id])
  acoesCorretivas AcaoCorretiva[]
  metricasDiarias MetricaDiariaUsina[]
}

model EstacaoSolarimetrica {
  id            String   @id @default(cuid())
  nome          String
  apiFornecedor String   @default("ISOFEN")
  apiId         String
  localizacao   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  usinas        Usina[]
}

model Inversor {
  id                String   @id @default(cuid())
  usinaId           String
  numeroSerie       String   @unique
  modelo            String
  potenciaNominalKW Float
  status            String   @default("ONLINE")
  createdAt         DateTime @default(now())
  usina             Usina    @relation(fields: [usinaId], references: [id], onDelete: Cascade)
}

model Telemetria {
  id                  String   @id @default(cuid())
  usinaId             String
  timestamp           DateTime @default(now())
  potenciaAtivaKW     Float
  energiaAcumuladaKWh Float
  irradiancia         Float?
  tempAmbiente        Float?
  tempModulos         Float?
  correnteCA_A        Float?
  correnteCA_B        Float?
  correnteCA_C        Float?
  dadosStrings        Json?
  frequenciaRede      Float?
  potenciaCA_A        Float?
  potenciaCA_B        Float?
  potenciaCA_C        Float?
  statusInversor      String?  @default("ONLINE")
  tempIGBT            Float?
  tensaoCA_A          Float?
  tensaoCA_B          Float?
  tensaoCA_C          Float?
  usina               Usina    @relation(fields: [usinaId], references: [id], onDelete: Cascade)

  @@index([usinaId, timestamp])
}

model Alarme {
  id              String    @id @default(cuid())
  usinaId         String
  codigo          String
  descricao       String
  gravidade       String    @default("MEDIA")
  solucaoSugerida String?
  status          String    @default("ATIVO")
  timestamp       DateTime  @default(now())
  dataResolucao   DateTime?
  usina           Usina     @relation(fields: [usinaId], references: [id], onDelete: Cascade)

  @@index([usinaId, status])
}

model AnalisePerda {
  id               String   @id @default(cuid())
  usinaId          String
  dataAnalise      DateTime @default(now())
  perdaSujidade    Float    @default(0)
  perdaClipping    Float    @default(0)
  perdaDowntime    Float    @default(0)
  perdaTemperatura Float    @default(0)
  performanceRatio Float
  insightsAI       String?
  usina            Usina    @relation(fields: [usinaId], references: [id], onDelete: Cascade)
}

model AcaoCorretiva {
  id           String   @id @default(cuid())
  usinaId      String
  tipoAcao     String   // 'limpeza_modulos', 'troca_fusivel', 'reparo_string', 'poda_vegetacao'
  dataExecucao DateTime
  observacoes  String?
  executadoPor String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  usina        Usina    @relation(fields: [usinaId], references: [id], onDelete: Cascade)
}

model MetricaDiariaUsina {
  id                         String   @id @default(cuid())
  data                       DateTime
  usinaId                    String
  energiaRealKWh             Float
  energiaProjetadaPvlibKWh   Float
  performanceRatioReal       Float
  integralSolarimetricaKWhM2 Float
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  usina                      Usina    @relation(fields: [usinaId], references: [id], onDelete: Cascade)

  @@unique([data, usinaId])
}

model Ativo {
  id                         String               @id @default(cuid())
  nome                       String
  codigo                     String               @unique
  categoria                  String               // "PESADO" ou "FERRAMENTA"
  status                     String               @default("DISPONIVEL") // "DISPONIVEL", "EM_USO", "MANUTENCAO"
  taxaHoraria                Float?               // R$/h para máquinas pesadas
  horasUso                   Float                @default(0) // acumulado de horas de uso
  horasManutencaoPreventiva  Float?               // X horas para notificar revisão
  ultimoCustoHoras           Float                @default(0) // custo acumulado total
  responsavel                String?              // atual portador ou operador
  localizacao                String?              // obra ou sub-obra atual
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  movimentacoes              MovimentacaoAtivo[]
  historicoUso               HistoricoUsoAtivo[]
}

model MovimentacaoAtivo {
  id           String   @id @default(cuid())
  ativoId      String
  tipo         String   // "SAIDA" ou "RETORNO"
  data         DateTime @default(now())
  responsavel  String
  destino      String
  observacoes  String?
  createdAt    DateTime @default(now())
  ativo        Ativo    @relation(fields: [ativoId], references: [id], onDelete: Cascade)
}

model HistoricoUsoAtivo {
  id              String   @id @default(cuid())
  ativoId         String
  horasTrabalhadas Float
  dataUso         DateTime @default(now())
  custoCalculado  Float
  obra            String
  responsavel     String
  observacoes     String?
  createdAt       DateTime @default(now())
  ativo           Ativo    @relation(fields: [ativoId], references: [id], onDelete: Cascade)
}
